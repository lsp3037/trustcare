# ==============================================================================
# TRUST CARE SAAS — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local (ambiente de desenvolvimento) ou configure
# os segredos diretamente no painel do provedor de hospedagem (ex: Vercel / Cloud).
#
# AVISO DE SEGURANÇA: Nunca comite credenciais reais ou arquivos .env preenchidos
# no repositório de controle de versão.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMÍNIO E URL PÚBLICA DO SISTEMA
# ------------------------------------------------------------------------------
# URL canônica utilizada na montagem de links absolutos nos e-mails transacionais
# (aprovação de orçamentos, rastreamento de ordens de serviço e portal do cliente).
# Em desenvolvimento: http://localhost:3000
# Em produção: https://app.trustcare.com.br
NEXT_PUBLIC_SITE_URL=https://app.trustcare.com.br

# ------------------------------------------------------------------------------
# 2. SUPABASE (BANCO DE DADOS & AUTENTICAÇÃO MULTI-TENANT)
# ------------------------------------------------------------------------------
# URL da API REST/GraphQL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima (pública) com escopo restrito a políticas RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço administrativo (privada do servidor). NUNCA exponha no frontend.
# Utilizada em rotas de webhook, cron jobs e provisionamento de novos tenants.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# String de conexão direta PostgreSQL (usada exclusivamente por scripts e migrações locais)
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ------------------------------------------------------------------------------
# 3. COMUNICAÇÃO TRANSACIONAL & E-MAILS (RESEND)
# ------------------------------------------------------------------------------
# Chave de API do Resend (https://resend.com/api-keys)
# Fora de produção: se ausente, o envio é simulado em log sem quebrar a execução.
# Em produção: obrigatória para envio real de e-mails transacionais.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwx

# Remetente oficial verificado no Resend
# Formato recomendado: "Nome da Plataforma <notificacoes@seudominio.com.br>"
RESEND_FROM_EMAIL=Trust Care <notificacoes@trustcare.com.br>

# Webhook secundário opcional para disparos de eventos de OS (ex: integração com n8n ou WhatsApp)
# WEBHOOK_URL=https://n8n.seudominio.com.br/webhook/os-events

# ------------------------------------------------------------------------------
# 4. GATEWAY DE PAGAMENTO & ASSINATURAS (ASAAS)
# ------------------------------------------------------------------------------
# Chave de API de integração com o Asaas
# Sandbox: obtida em https://sandbox.asaas.com/config/api
# Produção: obtida em https://www.asaas.com/config/api
ASAAS_API_KEY=$aact_YTU5Y...

# Token secreto de autenticação dos webhooks recebidos do Asaas (cabeçalho asaas-access-token).
# Validado via comparação em tempo constante (crypto.timingSafeEqual).
ASAAS_WEBHOOK_TOKEN=whsec_your_asaas_webhook_secret_token

# Ambiente do Asaas: "production" ou "sandbox"
ASAAS_ENVIRONMENT=production

# Flag de controle de simulação de checkout sem gateway real (F-03).
# VALOR OBRIGATÓRIO EM PRODUÇÃO: 0 (Desativado).
# Em desenvolvimento/testes locais sem credenciais de sandbox, pode ser alternado para 1.
ENABLE_BILLING_SIMULATION=0

# URL base da API do Asaas (Opcional, resolvida automaticamente com base em ASAAS_ENVIRONMENT)
# Produção: https://api.asaas.com/v3
# Sandbox:  https://sandbox.asaas.com/v3
# ASAAS_BASE_URL=https://api.asaas.com/v3

# ------------------------------------------------------------------------------
# 5. SEGURANÇA, ROTINAS CRON & ACESSO DE PLATAFORMA
# ------------------------------------------------------------------------------
# Token secreto Bearer para autorizar a rota de expiração diária de trials (/api/cron/expire-trials)
CRON_SECRET=super_secret_cron_bearer_token_32_chars_min

# Segredo para assinatura de tokens de sessão do Portal do Cliente (fallback para SUPABASE_SERVICE_ROLE_KEY)
PORTAL_SESSION_SECRET=super_secret_portal_jwt_secret_key_random

# Lista de e-mails de administradores globais da plataforma Trust Care (separados por vírgula)
# Usuários listados aqui têm acesso autorizado ao /backoffice de gestão de tenants.
PLATFORM_ADMIN_EMAILS=superadmin@trustcare.com.br,diretoria@trustcare.com.br

# ------------------------------------------------------------------------------
# 6. LOGÍSTICA & ROTEAMENTO (OPENROUTESERVICE / HEIGIT)
# ------------------------------------------------------------------------------
# Chave de API do OpenRouteService (https://account.heigit.org)
# Utilizada exclusivamente no backend para geocodificação e rotas de retirada/devolução.
# NUNCA exponha no frontend (sem prefixo NEXT_PUBLIC_).
ORS_API_KEY=ey...

# Modo de distância opcional para desenvolvimento local (economia de cota):
# "route" (padrão): calcula rotas reais de carro via ORS
# "haversine": calcula por linha reta * 1.3 sem chamar a API externa
# LOGISTICS_DISTANCE_MODE=route

